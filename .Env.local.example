# Supabase (find these in Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (find these in Paystack Dashboard > Settings > API Keys)
PAYSTACK_SECRET_KEY=your-paystack-secret-key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Access fee in kobo (₦5,000 = 500000 kobo)
NEXT_PUBLIC_ACCESS_FEE_KOBO=500000

# Your deployed site URL (used for Paystack callback). For local dev use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000